{
  "name": "korea-web-agent",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/src/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "relay": "node --experimental-strip-types src/relay/server.ts",
    "connector": "node --experimental-strip-types src/relay/connector.ts",
    "local-agent": "node --experimental-strip-types src/relay/local-agent.ts"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13"
  }
}