# Cloud/PWA server
PORT=8787
HOST=127.0.0.1

# Set the same long random secret on the cloud server and the user's PC connector.
# Never commit the real value.
KWA_RELAY_SECRET=replace-with-a-long-random-secret

# PC connector only
KWA_CLOUD_URL=https://your-korea-web-agent.example
KWA_PROFILE_DIR=.kwa-profile
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux example: /usr/bin/chromium
CHROMIUM_PATH=
